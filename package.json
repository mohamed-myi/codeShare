{
  "name": "codeshare",
  "private": true,
  "scripts": {
    "dev": "bash scripts/run-with-env.sh turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck && tsc -p tsconfig.benchmark.json",
    "lint": "turbo lint && biome check scripts/benchmark-*.mjs scripts/e2e*.mjs scripts/test-stability.mjs e2e/",
    "lint:fix": "biome check --write .",
    "e2e": "node scripts/e2e.mjs",
    "e2e:ui": "node scripts/e2e.mjs --ui",
    "e2e:live": "node scripts/e2e.mjs --live",
    "db:migrate": "bash scripts/run-with-env.sh pnpm --filter @codeshare/db migrate",
    "db:seed": "bash scripts/run-with-env.sh pnpm --filter @codeshare/db seed",
    "invite": "bash scripts/run-with-env.sh pnpm --filter @codeshare/server invite --",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "pnpm db:down && docker compose up -d --wait && pnpm db:migrate && pnpm db:seed",
    "bootstrap": "bash scripts/setup.sh",
    "setup": "bash scripts/setup.sh",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "dev:fresh": "bash scripts/setup.sh --start-dev",
    "load-test": "pnpm --filter codeshare-load-tests lt",
    "load-test:all": "pnpm --filter codeshare-load-tests lt",
    "load-test:auto": "pnpm --filter codeshare-load-tests lt:auto",
    "load-test:smoke": "pnpm --filter codeshare-load-tests lt --auto-start --skip-db-setup --scenarios LT-2,LT-3",
    "test:harness": "node --test scripts/*.test.mjs",
    "test:stability": "node scripts/test-stability.mjs",
    "verify:benchmark": "node scripts/benchmark-preflight.mjs && pnpm lint && pnpm typecheck && pnpm build && pnpm test:harness && pnpm test --force && pnpm e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@biomejs/biome": "^2.4.14",
    "@playwright/test": "^1.59.1",
    "turbo": "^2.9.8",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msw"
    ],
    "overrides": {
      "dompurify": "3.4.0",
      "picomatch": "4.0.4",
      "postcss": "8.5.10"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT"
}
